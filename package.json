{
  "name": "media-summ",
  "version": "1.0.1",
  "type": "module",
  "bin": {
    "media-summ": "bin/media-summ.ts"
  },
  "scripts": {
    "start": "bun bin/media-summ.ts",
    "build": "node2bun build .",
    "build:all": "node2bun build . --all",
    "docker": "node2bun docker . --write",
    "publish-packages": "bun scripts/publish.ts",
    "fmt": "bun x @biomejs/biome@2.5.6 format --write .",
    "lint": "bun x @biomejs/biome@2.5.6 lint .",
    "compile": "bun x tsc --noEmit",
    "test": "bun test",
    "cov": "bun test --coverage",
    "check": "bun run fmt && bun run lint && bun run compile && bun run test && bun run cov"
  },
  "license": "ISC",
  "dependencies": {
    "@plussub/srt-vtt-parser": "^2.0.5",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "openai": "^6.32.0",
    "p-limit": "^7.3.0",
    "tough-cookie": "^6.0.1",
    "undici": "^7.24.4",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  },
  "packageManager": "bun@1.3.14"
}
